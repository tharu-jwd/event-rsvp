# Copy to .env for local development. All of these have safe defaults for
# running the API locally without a .env file at all.

PORT=3000

# Origin the API accepts credentialed (cookie) requests from. Must match
# wherever the Next.js client is actually running.
CLIENT_ORIGIN=http://localhost:3001

# Where the SQLite file lives. Defaults to ./data/app.db, which is what the
# Docker deploy bind-mounts as a volume.
# DB_PATH=./data/app.db

# Set to "production" to enable secure (HTTPS-only) session cookies. Leave
# unset for local development over plain HTTP.
# NODE_ENV=production
